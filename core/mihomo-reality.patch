index 00000000..464b56db
--- /dev/null
+++ b/component/tls/reality_handshake_test.go
@@ -0,0 +1,35 @@
+package tls
+
+import (
+	"net"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+func TestRealityMLKEMKeyShare(t *testing.T) {
+	for _, fingerprint := range []utls.ClientHelloID{utls.HelloChrome_Auto, utls.HelloFirefox_Auto, utls.HelloAndroid_11_OkHttp} {
+		client, server := net.Pipe()
+		conn := utls.UClient(client, &utls.Config{ServerName: "example.com"}, fingerprint)
+		if err := BuildX25519MLKEM768HandshakeState(conn); err != nil {
+			t.Fatalf("%s: %v", fingerprint.Client, err)
+		}
+		if conn.HandshakeState.State13.KeyShareKeys == nil || conn.HandshakeState.State13.KeyShareKeys.MlkemEcdhe == nil {
+			t.Errorf("%s: missing ML-KEM private key", fingerprint.Client)
+		}
+		for _, extension := range conn.Extensions {
+			if curves, ok := extension.(*utls.SupportedCurvesExtension); ok {
+				if len(curves.Curves) == 0 || curves.Curves[0] != utls.X25519MLKEM768 {
+					t.Errorf("%s: ML-KEM is not first in supported curves", fingerprint.Client)
+				}
+			}
+			if shares, ok := extension.(*utls.KeyShareExtension); ok {
+				if len(shares.KeyShares) == 0 || shares.KeyShares[0].Group != utls.X25519MLKEM768 || len(shares.KeyShares[0].Data) == 0 {
+					t.Errorf("%s: missing first ML-KEM key share", fingerprint.Client)
+				}
+			}
+		}
+		client.Close()
+		server.Close()
+	}
+}
