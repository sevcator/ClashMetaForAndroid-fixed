 	return nil
 }
 
+func BuildX25519MLKEM768HandshakeState(c *UConn) error {
+	spec, err := utls.UTLSIdToSpec(c.ClientHelloID)
+	if err != nil {
+		spec, err = utls.UTLSIdToSpec(utls.HelloChrome_Auto)
+		if err != nil {
+			return err
+		}
+	}
+	hasKeyShare := false
+	for _, extension := range spec.Extensions {
+		if _, ok := extension.(*utls.KeyShareExtension); ok {
+			hasKeyShare = true
+		}
+	}
+	if !hasKeyShare {
+		spec, err = utls.UTLSIdToSpec(utls.HelloChrome_Auto)
+		if err != nil {
+			return err
+		}
+	}
+	for _, extension := range spec.Extensions {
+		if curves, ok := extension.(*utls.SupportedCurvesExtension); ok {
+			curves.Curves = slices.DeleteFunc(curves.Curves, func(curve utls.CurveID) bool {
+				return curve == utls.X25519MLKEM768
+			})
+			curves.Curves = append([]utls.CurveID{utls.X25519MLKEM768}, curves.Curves...)
+		}
+		if shares, ok := extension.(*utls.KeyShareExtension); ok {
+			shares.KeyShares = slices.DeleteFunc(shares.KeyShares, func(share utls.KeyShare) bool {
+				return share.Group == utls.X25519MLKEM768
+			})
+			shares.KeyShares = append([]utls.KeyShare{{Group: utls.X25519MLKEM768}}, shares.KeyShares...)
+		}
+	}
+	c.ClientHelloID = utls.HelloCustom
+	if err := c.ApplyPreset(&spec); err != nil {
+		return err
+	}
+	return c.BuildHandshakeState()
+}
+
