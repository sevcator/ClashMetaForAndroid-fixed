@@ -0,0 +1,39 @@
+package outbound
+
+import (
+	"testing"
+
+	"github.com/metacubex/mihomo/common/structure"
+)
+
+func TestRealityVersionAndMLKEMOptions(t *testing.T) {
+	const key = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
+	config, err := (RealityOptions{PublicKey: key}).Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.ClientVersion != [3]byte{26, 3, 27} || !config.SupportX25519MLKEM768 {
+		t.Fatalf("unexpected defaults: %+v", config)
+	}
+	noMLKEM := false
+	config, err = (RealityOptions{PublicKey: key, ClientVersion: "26.9.8", SupportX25519MLKEM768: &noMLKEM}).Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.ClientVersion != [3]byte{26, 9, 8} || config.SupportX25519MLKEM768 {
+		t.Fatalf("unexpected overrides: %+v", config)
+	}
+	for _, version := range []string{"26.9", "256.1.1", "26.-1.1", "x.y.z"} {
+		if _, err := (RealityOptions{PublicKey: key, ClientVersion: version}).Parse(); err == nil {
+			t.Errorf("accepted invalid version %q", version)
+		}
+	}
+	var decoded RealityOptions
+	decoder := structure.NewDecoder(structure.Option{TagName: "proxy", WeaklyTypedInput: true, KeyReplacer: structure.DefaultKeyReplacer})
+	if err := decoder.Decode(map[string]any{"public-key": key, "support-x25519mlkem768": false}, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.SupportX25519MLKEM768 == nil || *decoded.SupportX25519MLKEM768 {
+		t.Fatal("explicit false ML-KEM option was not decoded")
+	}
+}
